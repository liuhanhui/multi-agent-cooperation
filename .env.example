# Runtime ports (defaults — do not collide with other local platforms)
MAC_API_PORT=4010
MAC_WEB_PORT=4011
MAC_REDIS_PORT=6410

# memory | redis  (M02/M03: start with memory; switch to redis when ready)
MAC_STORE=memory

# Optional Redis URL when MAC_STORE=redis
# REDIS_URL=redis://127.0.0.1:6410

# Agent provider default when cat.provider is missing/unknown:
# claude-code | codex | antigravity | fake
MAC_AGENT_PROVIDER=claude-code
# MAC_CLAUDE_COMMAND=claude
# MAC_CLAUDE_PERMISSION_MODE=dontAsk
# MAC_CODEX_COMMAND=codex
# Prefer approve-for-me (do not also set sandbox — Codex rejects both together)
# MAC_CODEX_APPROVE_FOR_ME=1
# Only used when MAC_CODEX_APPROVE_FOR_ME=0:
# MAC_CODEX_SANDBOX=workspace-write
# MAC_AGY_COMMAND=agy
# MAC_AGY_MODEL=
# MAC_AGY_SKIP_PERMISSIONS=1
# MAC_AGENT_CWD=.
# MAC_AGENT_TIMEOUT_MS=120000

# Optional: public base URL embedded in agent callbackUrl (M10)
# MAC_PUBLIC_BASE_URL=http://127.0.0.1:4010

# Optional: skills catalog (M12)
# MAC_SKILLS_DIR=skills
# MAC_SKILLS_TOKEN_BUDGET=4000

# Optional: stdio MCP server bridge (M13) — pnpm --filter @mac/api mcp
# MAC_API_BASE_URL=http://127.0.0.1:4010
# MAC_MCP_CALLBACK_TOKEN=
# MAC_MCP_FAMILY=claude-code

# Read-only cat registry (copy from agent-config.example.json)
# MAC_AGENT_CONFIG=agent-config.json
