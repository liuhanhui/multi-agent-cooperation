# Runtime ports (defaults — do not collide with other local platforms)
MAC_API_PORT=4010
MAC_WEB_PORT=4011
MAC_REDIS_PORT=6410

# memory | redis  (M02/M03: start with memory; switch to redis when ready)
MAC_STORE=memory

# Optional Redis URL when MAC_STORE=redis
# REDIS_URL=redis://127.0.0.1:6410

# Agent provider: claude-code (default) | fake
MAC_AGENT_PROVIDER=claude-code
# MAC_CLAUDE_COMMAND=claude
# MAC_CLAUDE_PERMISSION_MODE=dontAsk
# MAC_AGENT_CWD=.
# MAC_AGENT_TIMEOUT_MS=120000

# Read-only cat registry (copy from agent-config.example.json)
# MAC_AGENT_CONFIG=agent-config.json
